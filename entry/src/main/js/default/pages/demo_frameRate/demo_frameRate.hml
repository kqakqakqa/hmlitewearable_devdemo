<div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  <list ref="bindRotation" on:swipe="swipeBack"
    style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">

    <!-- timeBattery -->
    <list-item class="timeBatteryWrapper"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
      <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center;">
      <stack style="width: {{uiSizes.uiWidth}}px; height: 72px;">
        <text class="text-38px title-text">渲染帧率</text>
        <div on:click="clickBack" class="ui-round-btn" style="left: {{uiSizes.uiWidth - 72}}px;">
          <image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image>
        </div>
      </stack>
    </list-item>

    <!-- 帧率显示 -->
    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div on:click="runTest({{$item.name}})" class="text-btnCard"
        style="width: {{uiSizes.uiWidth}}px; height: 124px; flex-direction: column; justify-content: center; align-items: flex-start;">
        <text class="text-30px text-btnCard-title">数量：{{elements.length}}</text>
        <text class="text-30px text-btnCard-title">帧率：30 → {{currentFps}}</text>
      </div>
    </list-item>

    <!-- 渲染区域 -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 192px; justify-content: center;">
      <stack if="{{stackVisible}}"
        style="width: {{uiSizes.uiWidth}}px; height: 180px; background-color: #222; border-radius: 24px;">
        <div for="{{elements}}"
          style="width: 12px; height: 12px; left: {{$item.x - 6}}px; top: {{$item.y - 6}}px; border-radius: 12px; background-color: cornflowerblue;">
        </div>
      </stack>
    </list-item>

    <!-- 控制按钮 -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 132px; justify-content: center;">
      <div style="width: 276px; height: 126px; flex-wrap: wrap; justify-content: space-between;">
        <text on:click="startAnimation" class="btn">开始</text>
        <text on:click="stopAnimation" class="btn">停止</text>
        <text on:click="addElements(1)" class="btn">+1元素</text>
        <text on:click="clearElements" class="btn">清除元素</text>
        <text on:click="hideElements" class="btn">隐藏</text>
        <text on:click="showElements" class="btn">显示</text>
      </div>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin - 12}}px; background-color: transparent;"></list-item>

  </list>
</div>
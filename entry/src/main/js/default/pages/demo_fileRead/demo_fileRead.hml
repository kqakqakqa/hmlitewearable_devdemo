<div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  <list ref="bindRotation" on:swipe="swipeBack"
    style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">

    <!-- timeBattery -->
    <list-item class="timeBatteryWrapper"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
      <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center;">
      <stack style="width: {{uiSizes.uiWidth}}px; height: 72px;">
        <text class="text-38px title-text">文本读取</text>
        <div on:click="clickBack" class="ui-round-btn" style="left: {{uiSizes.uiWidth - 72}}px;">
          <image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image>
        </div>
      </stack>
    </list-item>

    <!-- text -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 91px; justify-content: center;">
      <div
        style="width: {{uiSizes.uiWidth}}px; height: 79px; background-color: #222; border-radius: 12px; align-items: center; padding: 6px;">
        <text class="text-30px" style="width: {{uiSizes.uiWidth}}px; height: 79px;">{{text}}</text>
      </div>
    </list-item>

    <!-- text -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 186px; justify-content: center;">
      <div
        style="width: {{uiSizes.uiWidth}}px; height: 174px; background-color: #222; border-radius: 12px; align-items: center; padding: 6px;">
        <text class="text-30px" style="width: {{uiSizes.uiWidth}}px; height: 174px;">{{utf}}</text>
      </div>
    </list-item>

    <!-- binary -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 215px; justify-content: center;">
      <div
        style="width: {{uiSizes.uiWidth}}px; height: 203px; background-color: #222; border-radius: 12px; align-items: center; padding: 6px;">
        <text class="text-30px" style="width: {{uiSizes.uiWidth}}px; height: 203px;">{{binary}}</text>
      </div>
    </list-item>

    <!-- btn -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 72px; justify-content: center;">
      <div style="width: {{uiSizes.uiWidth}}px; height: 378px; flex-wrap: wrap;">
        <text on:click="changeReadPos(-1)" class="btn">-1</text>
        <text class="text-30px" style="margin-right: 6px;">{{readPos}}</text>
        <text on:click="changeReadPos(1)" class="btn">+1</text>
      </div>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin}}px; background-color: transparent;"></list-item>

  </list>
</div>
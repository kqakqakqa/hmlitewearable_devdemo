<stack style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; background-color: transparent;">
  <image src="/common/background.png" style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;"></image>
  <div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; background-color: transparent;">
  <list ref="bindRotation" grab:swipe="swipeBack"
    style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; background-color: transparent;">

    <!-- timeBattery -->
    <list-item class="timeBatteryWrapper"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
      <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item
      style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center; background-color: transparent;">
      <stack style="width: {{uiSizes.uiWidth}}px; height: 72px; background-color: transparent;">
        <text class="text-38px title-text">列表渲染</text>
        <div grab:click="clickBack" class="roundBtn" style="left: {{uiSizes.uiWidth - 72}}px;">
          <image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image>
        </div>
      </stack>
    </list-item>

    <!-- arr -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 54px; justify-content: center;">
      <div
        style="width: {{uiSizes.uiWidth}}px; height: 48px; background-color: #22ffffff; border-radius: 12px; align-items: center; padding: 6px;">
        <text for="{{arr}}" style="font-size: 30px;">{{$item.v}}</text>
      </div>
    </list-item>

    <!-- btn -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 384px; justify-content: center;">
      <div style="width: 276px; height: 378px; flex-wrap: wrap; justify-content: space-between;">
        <text grab:click="clickBtn('same')" class="btn">=arr</text>
        <text grab:click="clickBtn('push')" class="btn">push</text>
        <text grab:click="clickBtn('pop')" class="btn">pop</text>
        <text grab:click="clickBtn('shift')" class="btn">shift</text>
        <text grab:click="clickBtn('unshift')" class="btn">unshift</text>
        <text grab:click="clickBtn('reverse')" class="btn">reverse</text>
        <text grab:click="clickBtn('sort')" class="btn" style="color: gold;">sort</text>

        <text grab:click="clickBtn('forEachV')" class="btn">forEa(v)</text>
        <text grab:click="clickBtn('forEachI')" class="btn">forEa(v,i)</text>
        <text grab:click="clickBtn('forOf')" class="btn" style="color: orangered;">for...of</text>
        <text grab:click="clickBtn('forIn')" class="btn">for...in</text>
        <text grab:click="clickBtn('forLet')" class="btn">for(i)</text>

        <text grab:click="clickBtn('index')" class="btn">arr[0]=</text>
        <text grab:click="clickBtn('fill')" class="btn" style="color: coral;">fill</text>
        <text grab:click="clickBtn('splice')" class="btn">splice</text>

        <text grab:click="clickBtn('from')" class="btn" style="color: coral;">=Ar.from</text>
        <text grab:click="clickBtn('assign')" class="btn">=[]</text>
        <text grab:click="clickBtn('len0')" class="btn" style="color: gold;">len=0</text>
      </div>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin - 12}}px; background-color: transparent;"></list-item>

  </list>
  </div>
</stack>
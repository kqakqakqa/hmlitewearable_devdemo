<stack style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; background-color: transparent;">
  <image src="/common/background.png" style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;"></image>
  <div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; background-color: transparent;">
  <list ref="bindRotation" on:swipe="swipeBack"
    style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; background-color: transparent;">

    <!-- timeBattery -->
    <list-item class="timeBatteryWrapper"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
      <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item
      style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center; background-color: transparent;">
      <stack style="width: {{uiSizes.uiWidth}}px; height: 72px; background-color: transparent;">
        <text class="text-38px title-text">DevDemo</text>
        <div on:click="clickCard('menu')" class="roundBtn" style="left: {{uiSizes.uiWidth - 72}}px;">
          <image style="width: 44px; height: 44px;" src="/common/dot_grid_2x2-44px.png"></image>
        </div>
      </stack>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_arrRender')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">列表渲染</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_jsHeap')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">js heap</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_onEvent')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">事件</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_fontSize')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">文字大小</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_fileRead')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">文本读取</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_fetchSize')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">fetch大小</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_canvas')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">canvas</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_domRender')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">渲染帧率</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_loopPerformance')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">循环性能</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_calcPerformance')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">运算性能</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_deviceInfo')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">设备信息</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_sensorSubscribe')" class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px;">
        <div class="interactiveCard-row">
          <text class="text-30px interactiveCard-rowText">传感器订阅</text>
          <image class="interactiveCard-actionIcon" src="/common/chevron_right-30px-gray.png"></image>
        </div>
      </div>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin - 12}}px; background-color: transparent;"></list-item>

  </list>
  </div>
</stack>
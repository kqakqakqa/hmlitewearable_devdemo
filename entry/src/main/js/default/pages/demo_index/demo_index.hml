<div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  <list ref="bindRotation" on:swipe="swipeBack"
    style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">

    <!-- timeBattery -->
    <list-item class="timeBatteryWrapper"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
      <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item
      style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center; background-color: transparent;">
      <stack style="width: {{uiSizes.uiWidth}}px; height: 72px; background-color: transparent;">
        <text class="text-38px title-text">DevDemo</text>
        <div on:click="clickCard('menu')" class="ui-round-btn" style="left: {{uiSizes.uiWidth - 72}}px;">
          <image style="width: 44px; height: 44px;" src="/common/dot_grid_2x2-44px.png"></image>
        </div>
      </stack>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_hmlFor')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">列表渲染</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_jsHeap')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">js heap</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_onEvent')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">事件</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_fontSize')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">文字大小</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_fileRead')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">文本读取</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_fetchSize')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">fetch大小</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_canvas')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">canvas</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_frameRate')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">渲染帧率</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_loopSpeed')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">循环速度</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="clickCard('demo_deviceInfo')" class="text-btnCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">设备信息</text>
        <image class="text-btnCard-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin - 12}}px; background-color: transparent;"></list-item>

  </list>
</div>
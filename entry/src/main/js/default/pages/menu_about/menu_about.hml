<div on:swipe="swipeBack"
  style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; flex-direction: column; align-items: center; justify-content: center;">
  <image src="/common/icon.png" style="width: 114px; height: 114px; margin-top: 12px; margin-bottom: 12px;"></image>
  <text class="text-30px">DevDemo</text>
  <text class="text-30px" style="color: gray;">v{{versionName}}</text>
</div>
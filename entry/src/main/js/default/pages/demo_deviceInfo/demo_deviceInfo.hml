<div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  <list ref="bindRotation" on:swipe="swipeBack"
    style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">

    <!-- timeBattery -->
    <list-item class="timeBatteryWrapper"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
      <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item
      style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center; background-color: transparent;">
      <stack style="width: {{uiSizes.uiWidth}}px; height: 72px; background-color: transparent;">
        <text class="text-38px title-text">设备信息</text>
        <div on:click="clickBack" class="ui-round-btn" style="left: {{uiSizes.uiWidth - 72}}px;">
          <image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image>
        </div>
      </stack>
    </list-item>

    <!-- 设备信息卡片 -->

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">品牌</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{brand}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">生产商</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{manufacturer}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">型号</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{model}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">代号</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{product}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">系统语言</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{language}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">系统地区</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{region}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">横向分辨率(px)</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{windowWidth}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">纵向分辨率(px)</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{windowHeight}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">像素密度(dpi)</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{screenDensity}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">屏幕形状</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{screenShape}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">系统API版本</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{apiVersion}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">设备类型</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{deviceType}}</text>
      </div>
    </list-item>

    <list-item class="text-btnCard-wrapper infoCard-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div class="text-btnCard infoCard" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px text-btnCard-title">WearEngine版本</text>
        <text class="text-30px text-btnCard-title infoCard-content" style="color: gray;">{{wearEngineVersion}}</text>
      </div>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin - 12}}px; background-color: transparent;"></list-item>

  </list>
</div>
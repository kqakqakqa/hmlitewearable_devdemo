<div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  <list ref="bindRotation" on:swipe="swipeBack"
    style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">

    <!-- timeBattery -->
    <list-item class="timeBatteryWrapper"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
      <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item
      style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center; background-color: transparent;">
      <stack style="width: {{uiSizes.uiWidth}}px; height: 72px; background-color: transparent;">
        <text class="text-38px title-text">设备信息</text>
        <div on:click="clickBack" class="roundBtn" style="left: {{uiSizes.uiWidth - 72}}px;">
          <image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image>
        </div>
      </stack>
    </list-item>

    <!-- 设备信息卡片 -->

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">品牌</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{brand}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">生产商</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{manufacturer}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">型号</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{model}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">代号</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{product}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">系统语言</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{language}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">系统地区</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{region}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">横向分辨率(px)</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{windowWidth}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">纵向分辨率(px)</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{windowHeight}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">像素密度(dpi)</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{screenDensity}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">屏幕形状</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{screenShape}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">系统API版本</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{apiVersion}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">设备类型</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{deviceType}}</text>
      </div>
    </list-item>

    <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
      <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
        <text class="text-30px interactiveCard-rowText">WearEngine版本</text>
        <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{wearEngineVersion}}</text>
      </div>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin - 12}}px; background-color: transparent;"></list-item>

  </list>
</div>
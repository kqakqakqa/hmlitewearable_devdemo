<div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  <list ref="bindRotation" style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">

    <!-- timeBattery -->
    <list-item class="timeBatteryWrapper"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
      <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center;">
      <stack on:swipe="swipeBack" style="width: {{uiSizes.uiWidth}}px; height: 72px;">
        <text class="text-38px title-text">js heap</text>
        <div on:click="clickBack" class="ui-round-btn" style="left: {{uiSizes.uiWidth - 72}}px;">
          <image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image>
        </div>
      </stack>
    </list-item>

    <!-- model jsHeap -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 114px; justify-content: center;">
      <text style="width: {{uiSizes.screenWidth}}px; font-size: 30px; text-align: center;">
        型号: {{model}}\njs heap: {{jsHeap}}\n{{doTest ? "将在下次启动时测试" : ""}}
      </text>
    </list-item>

    <!-- btn -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 72px; flex-direction: column; align-items: center;">
      <text on:click="clickBtn" class="ui-btn">{{doTest ? "取消" : "下次启动时测试"}}</text>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin}}px; background-color: transparent;"></list-item>

  </list>
</div>
<div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  <list ref="bindRotation" style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">

    <!-- timeBattery -->
    <list-item class="timeBatteryWrapper"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
      <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center;">
      <stack on:swipe="swipeBack" style="width: {{uiSizes.uiWidth}}px; height: 72px;">
        <text class="text-38px title-text">列表渲染</text>
        <div on:click="clickBack" class="ui-round-btn" style="left: {{uiSizes.uiWidth - 72}}px;">
          <image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image>
        </div>
      </stack>
    </list-item>

    <!-- arr -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 54px; justify-content: center;">
      <div
        style="width: {{uiSizes.uiWidth}}px; height: 48px; background-color: #222; border-radius: 12px; align-items: center; padding: 6px;">
        <text for="{{arr}}" style="font-size: 30px;">{{$item.v}}</text>
      </div>
    </list-item>

    <!-- btn -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 378px; justify-content: center;">
      <div style="width: {{uiSizes.uiWidth}}px; height: 378px; flex-wrap: wrap;">
        <text on:click="{{clickBtn('same')}}" class="btn">=arr</text>
        <text on:click="{{clickBtn('push')}}" class="btn">push</text>
        <text on:click="{{clickBtn('pop')}}" class="btn">pop</text>
        <text on:click="{{clickBtn('shift')}}" class="btn">shift</text>
        <text on:click="{{clickBtn('unshift')}}" class="btn">unshift</text>
        <text on:click="{{clickBtn('reverse')}}" class="btn">reverse</text>
        <text on:click="{{clickBtn('sort')}}" class="btn" style="color: gold;">sort</text>

        <text on:click="{{clickBtn('forEachV')}}" class="btn">forEa(v)</text>
        <text on:click="{{clickBtn('forEachI')}}" class="btn">forEa(v,i)</text>
        <text on:click="{{clickBtn('forOf')}}" class="btn" style="color: orangered;">for...of</text>
        <text on:click="{{clickBtn('forIn')}}" class="btn">for...in</text>
        <text on:click="{{clickBtn('forLet')}}" class="btn">for(i)</text>

        <text on:click="{{clickBtn('index')}}" class="btn">arr[0]=</text>
        <text on:click="{{clickBtn('fill')}}" class="btn" style="color: coral;">fill</text>
        <text on:click="{{clickBtn('splice')}}" class="btn">splice</text>

        <text on:click="{{clickBtn('from')}}" class="btn" style="color: coral;">=Ar.from</text>
        <text on:click="{{clickBtn('assign')}}" class="btn">=[]</text>
        <text on:click="{{clickBtn('len0')}}" class="btn" style="color: gold;">len=0</text>
      </div>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin}}px; background-color: transparent;"></list-item>

  </list>
</div>
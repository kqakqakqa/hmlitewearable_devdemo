<stack style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; background-color: transparent;">
  <image src="/common/background.png" style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  </image>
  <div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; background-color: transparent;">
    <list ref="bindRotation" on:swipe="swipeBack"
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px; background-color: transparent;">

      <!-- timeBattery -->
      <list-item class="timeBatteryWrapper"
        style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;">
        <text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text>
      </list-item>

      <!-- title -->
      <list-item
        style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center; background-color: transparent;">
        <stack style="width: {{uiSizes.uiWidth}}px; height: 72px; background-color: transparent;">
          <text class="text-38px title-text">传感器订阅</text>
          <div on:click="clickBack" class="roundBtn" style="left: {{uiSizes.uiWidth - 72}}px;">
            <image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image>
          </div>
        </stack>
      </list-item>

      <!-- 线性加速度 -->
      <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
        <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
          <text class="text-30px interactiveCard-rowText">线性加速度</text>
          <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{accelerometer}}</text>
        </div>
      </list-item>

      <!-- 旋转角速度 -->
      <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
        <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
          <text class="text-30px interactiveCard-rowText">旋转角速度</text>
          <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{gyroscope}}</text>
        </div>
      </list-item>

      <!-- 磁场 -->
      <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
        <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
          <text class="text-30px interactiveCard-rowText">磁场</text>
          <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{compass}}</text>
        </div>
      </list-item>

      <!-- 计步 -->
      <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
        <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
          <text class="text-30px interactiveCard-rowText">计步</text>
          <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{stepCounter}}</text>
        </div>
      </list-item>

      <!-- 气压 -->
      <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
        <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
          <text class="text-30px interactiveCard-rowText">气压</text>
          <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{barometer}}</text>
        </div>
      </list-item>

      <!-- 心率 -->
      <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
        <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
          <text class="text-30px interactiveCard-rowText">心率</text>
          <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{heartRate}}</text>
        </div>
      </list-item>

      <!-- 佩戴状态 -->
      <list-item class="interactiveCard-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 136px;">
        <div class="interactiveCard-base" style="width: {{uiSizes.uiWidth}}px; height: 124px;">
          <text class="text-30px interactiveCard-rowText">佩戴状态</text>
          <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap">{{onBodyState}}</text>
        </div>
      </list-item>

      <!-- 更多 -->
      <list-item class="interactiveCard-wrapper" if="{{!!moreSensorsLen}}"
        style="width: {{uiSizes.screenWidth}}px; height: {{38 + 6 + moreSensorsLen * 41.25 - 3.75 + 48 + 12}}px;">
        <div class="interactiveCard-base"
          style="width: {{uiSizes.uiWidth}}px; height: {{38 + 6 + moreSensorsLen * 41.25 - 3.75 + 48}}px;">
          <text class="text-30px interactiveCard-rowText">更多</text>
          <text class="text-30px interactiveCard-rowText text-gray interactiveCard-textRowGap"
            style="height: {{6 + moreSensorsLen * 41.25 - 3.75}}px;">{{moreSensorsStr}}</text>
        </div>
      </list-item>

      <list-item style="width: 0px; height: {{uiSizes.topMargin - 12}}px; background-color: transparent;"></list-item>

    </list>
  </div>
</stack>
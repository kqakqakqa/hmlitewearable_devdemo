<div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  <list ref="mainList" style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">

    <!-- timeBattery -->
    <list-item
      style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px; align-items: flex-end; justify-content: center;">
      <text class="text-30px" style="width: 280px; margin-bottom: 24px; text-align: center;">{{timeBatteryStr}}</text>
    </list-item>

    <!-- title -->
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center;">
      <stack on:swipe="swipeBack" style="width: {{uiSizes.uiWidth}}px; height: 72px;">
        <div style="width: 280px; height: 72px; align-items: center;">
          <text class="text-38px">选项</text>
        </div>
        <div
          style="width: {{uiSizes.uiWidth}}px; height: 72px; justify-content: flex-end; background-color: transparent;">
          <div on:click="clickBack" class="ui-round-btn">
            <image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image>
          </div>
        </div>
      </stack>
    </list-item>

    <list-item class="btn-card-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="{{pageTo('menu_about')}}" class="btn-card" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px btn-card-title">关于</text>
        <image class="btn-card-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="btn-card-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="{{pageTo('menu_licenses')}}" class="btn-card" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px btn-card-title">开放源代码许可</text>
        <image class="btn-card-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="btn-card-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="{{pageTo('menu_sponsor')}}" class="btn-card" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px btn-card-title">支持作者</text>
        <image class="btn-card-go-icon" src="/common/chevron_right-30px-gray.png"></image>
      </div>
    </list-item>

    <list-item class="btn-card-wrapper" style="width: {{uiSizes.screenWidth}}px;">
      <div on:click="exitApp" class="btn-card" style="width: {{uiSizes.uiWidth}}px;">
        <text class="text-30px btn-card-title">退出应用</text>
        <image class="btn-card-go-icon" src="/common/leave_home_fill-30px.png">
        </image>
      </div>
    </list-item>

    <list-item style="width: 0px; height: {{uiSizes.topMargin}}px; background-color: transparent;"></list-item>

  </list>
</div>